# Dockerfile for running af_normalize_text tests
# Usage: docker build -f Dockerfile.test -t af_normalize_text:test .
#        docker run --rm af_normalize_text:test

FROM php:8.2-cli-alpine

# Install required PHP extensions
# intl: provides Normalizer::normalize() for NFKC normalization (primary method)
# Note: mbstring is bundled in PHP Alpine images for fallback normalization
RUN apk add --no-cache \
    $PHPIZE_DEPS \
    icu-dev \
    && docker-php-ext-install \
    intl \
    && apk del $PHPIZE_DEPS

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /app

# Copy plugin files
COPY . /app

# Install dependencies
RUN composer install --no-interaction --prefer-dist

# Run tests by default
CMD ["./vendor/bin/phpunit", "--testdox", "--colors=always"]
